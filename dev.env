# =============================================================================
# Coridor — Local IDR Anchor (Hackathon)
# Copy to .env.secrets and fill in your keys before running ./ap_start.sh
# =============================================================================

# Stellar Network — use Horizon for classic USDC payments (RPC observer misses trustline payments)
STELLAR_NETWORK_TYPE=horizon
STELLAR_NETWORK_HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC (optional, for contract ops only)
STELLAR_NETWORK_RPC_URL=https://soroban-testnet.stellar.org

# Distribution wallet (USDC Blend inventory)
DISTRIBUTION_ACCOUNT=GCACTDNRY4V7QD4M6FSPGLCR5BNANSLBHIKACRTPSZ4B75NKL66QGSVS
# Set in .env.secrets — never commit:
# SECRET_DISTRIBUTION_SEED=
# SECRET_SEP10_SIGNING_SEED=

# Asset identifiers
CORIDOR_USDC_ASSET=stellar:USDC:GATALTGTWIOT6BUDBCZM3Q4OQ4BO2COLOAZ7IYSKPLC2PMSOPPGF5V56
CORIDOR_IDR_ASSET=iso4217:IDR

# Database
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=password
DATA_TYPE=postgres
DATA_SERVER=db:5432
DATA_DATABASE=postgres
DATA_SCHEMA=anchor-platform
DATA_FLYWAY_ENABLED=true

# JWT secrets (shared with coridor-server)
SECRET_SEP6_MORE_INFO_URL_JWT_SECRET=coridor_sep6_more_info_jwt_secret_32chars
SECRET_SEP10_JWT_SECRET=coridor_sep10_jwt_secret_32chars_min
SECRET_SEP45_JWT_SECRET=coridor_sep45_jwt_secret_32chars_min
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET=coridor_sep24_interactive_jwt_secret
SECRET_SEP24_MORE_INFO_URL_JWT_SECRET=coridor_sep24_more_info_jwt_secret

# Logging
APP_LOGGING_STELLAR_LEVEL=INFO
APP_LOGGING_REQUEST_LOGGER_ENABLED=true
LANGUAGES=id,en

# Events (Kafka)
EVENTS_ENABLED=true
EVENTS_QUEUE_TYPE=kafka
EVENTS_QUEUE_KAFKA_BOOTSTRAP_SERVER=kafka:29092
EVENT_PROCESSOR_CALLBACK_API_REQUEST_ENABLED=true
EVENT_PROCESSOR_CLIENT_STATUS_CALLBACK_ENABLED=false

# API endpoints
CALLBACK_API_BASE_URL=http://coridor-server:8091
PLATFORM_API_BASE_URL=http://platform:8085

# Assets & SEP-1
ASSETS_TYPE=file
ASSETS_VALUE=/config/assets.yaml
CLIENTS_TYPE=file
CLIENTS_VALUE=/config/clients.yaml
SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/config/stellar.localhost.toml

# SEP-6 (required bean for SEP-24 IDR↔USDC exchange)
SEP6_ENABLED=true

# SEP-10
SEP10_ENABLED=true
SEP10_WEB_AUTH_DOMAIN=localhost:8082
SEP10_HOME_DOMAINS=localhost:8082

# SEP-12 KYC
SEP12_ENABLED=true

# SEP-24 Interactive
SEP24_ENABLED=true
SEP24_INTERACTIVE_URL_BASE_URL=http://localhost:8091/sep24/interactive
SEP24_MORE_INFO_URL_BASE_URL=http://localhost:8091/sep24/transaction/more_info
SEP24_INITIAL_USER_DEADLINE_SECONDS=86400

# SEP-31 (required with SEP-6+SEP-24 for exchangeAmountsCalculator bean)
SEP31_ENABLED=true

# SEP-38 quotes (dynamic rate via coridor-server /rate callback)
SEP38_ENABLED=true

# SEP-45 (disabled — conflicts with Horizon observer; SEP-24 hackathon only)
SEP45_ENABLED=false

# Platform API auth (coridor-server -> platform)
PLATFORM_API_AUTH_TYPE=none

# Callback auth (platform -> coridor-server) — none for local dev
CALLBACK_API_AUTH_TYPE=none
